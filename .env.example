# Canonical URLs (used for metadata, sitemap, JSON-LD, llms.txt)
NEXT_PUBLIC_SITE_URL=https://saverpe.com
NEXT_PUBLIC_ORBIT_URL=https://orbit.saverpe.com

# Shared Django leads API. Leave empty to run the contact form in mock mode.
NEXT_PUBLIC_LEADS_API_URL=http://127.0.0.1:8000

# Analytics & search console (optional)
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# IndexNow key (8–128 chars, a-z A-Z 0-9 -). Served at /indexnow-key.txt; used by scripts/indexnow.mjs
INDEXNOW_KEY=
